<Slide style={{
    width: 1280,
    height: 720,
    padding: '0 72px',
    background: '#FFFFFF',
}}>
    <Box style={{ width: '100%', height: 720, flexDirection: 'column' }}>
        <Box style={{
            height: 120,
            paddingTop: 20,
            paddingBottom: 16,
            flexDirection: 'row',
            alignItems: 'flex-end',
            justifyContent: 'space-between',
        }}>
            <Box style={{ flexDirection: 'column', justifyContent: 'flex-end' }}>
                <Box style={{ width: 56, height: 6, background: '#97C459', marginBottom: 14 }} />
                <Text style={{ fontFamily: 'Inter', fontSize: 34, fontWeight: 'bold', color: '#0B1F1A' }}>
                    Architecture
                </Text>
            </Box>
            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#6B7280', letterSpacing: 1.4, paddingBottom: 6 }}>
                END-TO-END PIPELINE
            </Text>
        </Box>

        <Box style={{ height: 540, flexDirection: 'column', gap: 16 }}>
            <svg width={1136} height={300} viewBox='0 0 1136 300'>
                <rect x='0' y='8' width='266' height='136' rx='7' fill='#E1F5EE' stroke='#0F6E56' strokeWidth='1' />
                <text x='16' y='40' fill='#0F6E56' fontSize='13' fontFamily='JetBrains Mono' letterSpacing='1.4'>INPUTS</text>
                <text x='16' y='72' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>audio · transcript</text>
                <text x='16' y='96' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>role image</text>

                <rect x='0' y='156' width='266' height='136' rx='7' fill='#E1F5EE' stroke='#0F6E56' strokeWidth='1' />
                <text x='16' y='188' fill='#0F6E56' fontSize='13' fontFamily='JetBrains Mono' letterSpacing='1.4'>GEMINI LIVE</text>
                <text x='16' y='220' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>full duplex,</text>
                <text x='16' y='244' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>interruptible transport</text>

                <rect x='290' y='8' width='266' height='136' rx='7' fill='#E1F5EE' stroke='#0F6E56' strokeWidth='1' />
                <text x='306' y='40' fill='#0F6E56' fontSize='13' fontFamily='JetBrains Mono' letterSpacing='1.4'>TOOL DISPATCHER</text>
                <text x='306' y='72' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>manifest · validate</text>
                <text x='306' y='96' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>dedupe · supersede</text>

                <rect x='290' y='156' width='266' height='136' rx='7' fill='#E1F5EE' stroke='#0F6E56' strokeWidth='1' />
                <text x='306' y='188' fill='#0F6E56' fontSize='13' fontFamily='JetBrains Mono' letterSpacing='1.4'>PLAN REVISION</text>
                <text x='306' y='220' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>filter_fingerprint</text>
                <text x='306' y='244' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>+ 4 branch fingerprints</text>

                <rect x='580' y='8' width='266' height='136' rx='7' fill='#E1F5EE' stroke='#0F6E56' strokeWidth='1' />
                <text x='596' y='40' fill='#0F6E56' fontSize='13' fontFamily='JetBrains Mono' letterSpacing='1.4'>BRANCH EXECUTOR</text>
                <text x='596' y='72' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>reuse · preserve</text>
                <text x='596' y='96' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>cancel · start</text>

                <rect x='580' y='156' width='266' height='136' rx='7' fill='#FFFFFF' stroke='#97C459' strokeWidth='2.5' />
                <text x='596' y='188' fill='#0F6E56' fontSize='13' fontFamily='JetBrains Mono' letterSpacing='1.4'>HYBRID RETRIEVAL</text>
                <text x='596' y='220' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>one shared eligibility CTE,</text>
                <text x='596' y='244' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>inlined into every branch</text>

                <rect x='870' y='8' width='266' height='136' rx='7' fill='#E1F5EE' stroke='#0F6E56' strokeWidth='1' />
                <text x='886' y='40' fill='#0F6E56' fontSize='13' fontFamily='JetBrains Mono' letterSpacing='1.4'>FUSION</text>
                <text x='886' y='72' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>RRF → rerank →</text>
                <text x='886' y='96' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>diversity</text>

                <rect x='870' y='156' width='266' height='136' rx='7' fill='#E1F5EE' stroke='#0F6E56' strokeWidth='1' />
                <text x='886' y='188' fill='#0F6E56' fontSize='13' fontFamily='JetBrains Mono' letterSpacing='1.4'>STATE + PROTOCOL</text>
                <text x='886' y='220' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>StateSnapshot → Journal</text>
                <text x='886' y='244' fill='#0B1F1A' fontSize='14' fontFamily='Inter'>→ ProtocolAdapter</text>

                <path d='M270 76 L286 76' stroke='#0F6E56' strokeWidth='2' />
                <path d='M286 76 L279 72 L279 80 Z' fill='#0F6E56' />
                <path d='M270 224 L286 224' stroke='#0F6E56' strokeWidth='2' />
                <path d='M286 224 L279 220 L279 228 Z' fill='#0F6E56' />

                <path d='M560 76 L576 76' stroke='#0F6E56' strokeWidth='2' />
                <path d='M576 76 L569 72 L569 80 Z' fill='#0F6E56' />
                <path d='M560 224 L576 224' stroke='#0F6E56' strokeWidth='2' />
                <path d='M576 224 L569 220 L569 228 Z' fill='#0F6E56' />

                <path d='M850 76 L866 76' stroke='#0F6E56' strokeWidth='2' />
                <path d='M866 76 L859 72 L859 80 Z' fill='#0F6E56' />
                <path d='M850 224 L866 224' stroke='#0F6E56' strokeWidth='2' />
                <path d='M866 224 L859 220 L859 228 Z' fill='#0F6E56' />

                <path d='M133 148 L133 152' stroke='#0F6E56' strokeWidth='2' />
                <path d='M133 152 L129 145 L137 145 Z' fill='#0F6E56' />
                <path d='M423 148 L423 152' stroke='#0F6E56' strokeWidth='2' />
                <path d='M423 152 L419 145 L427 145 Z' fill='#0F6E56' />
                <path d='M713 148 L713 152' stroke='#0F6E56' strokeWidth='2' />
                <path d='M713 152 L709 145 L717 145 Z' fill='#0F6E56' />
                <path d='M1003 148 L1003 152' stroke='#0F6E56' strokeWidth='2' />
                <path d='M1003 152 L999 145 L1007 145 Z' fill='#0F6E56' />
            </svg>

            <Box style={{ height: 224, flexDirection: 'row', gap: 24 }}>
                <Box style={{
                    flex: 1,
                    background: '#E1F5EE',
                    borderLeft: '5px solid #0F6E56',
                    padding: '24px 26px',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 13, color: '#0F6E56', letterSpacing: 1.5 }}>
                        DECISION 01
                    </Text>
                    <Text style={{ fontFamily: 'Inter', fontSize: 21, fontWeight: 'bold', color: '#04342C', lineHeight: 1.4, marginTop: 12 }}>
                        The shared eligibility clause is a cross-branch dependency
                    </Text>
                    <Text style={{ fontFamily: 'Inter', fontSize: 17, lineHeight: 1.55, color: '#0B1F1A', marginTop: 10 }}>
                        The hard filter is built once and inlined as a CTE into every branch query. The fingerprint model says
                        so out loud: <span style={{ fontFamily: 'JetBrains Mono', fontSize: 15, color: '#0F6E56' }}>filter_fingerprint</span> is
                        folded into each branch fingerprint, so a filter change invalidates all four branches while a query
                        rewrite invalidates only two.
                    </Text>
                </Box>

                <Box style={{
                    flex: 1,
                    background: '#E1F5EE',
                    borderLeft: '5px solid #0F6E56',
                    padding: '24px 26px',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 13, color: '#0F6E56', letterSpacing: 1.5 }}>
                        DECISION 02
                    </Text>
                    <Text style={{ fontFamily: 'Inter', fontSize: 21, fontWeight: 'bold', color: '#04342C', lineHeight: 1.4, marginTop: 12 }}>
                        A snapshot is either authoritative or it is not
                    </Text>
                    <Text style={{ fontFamily: 'Inter', fontSize: 17, lineHeight: 1.55, color: '#0B1F1A', marginTop: 10 }}>
                        Speculative work — retrieval started from a partial transcript — publishes
                        <span style={{ fontFamily: 'JetBrains Mono', fontSize: 15, color: '#0F6E56' }}> authoritative=False</span>.
                        A guess about what the user is about to say can never be mistaken for a decision they made, and the
                        turn cannot be closed on one.
                    </Text>
                </Box>
            </Box>
        </Box>

        <Box style={{
            height: 60,
            paddingBottom: 20,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}>
            <Text style={{ fontFamily: 'Inter', fontSize: 14, color: '#6B7280' }}>
                Talent Atlas · Samsung PRISM Y2026 · Theme 05
            </Text>
            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#6B7280' }}>
                05 / 12
            </Text>
        </Box>
    </Box>
</Slide>
