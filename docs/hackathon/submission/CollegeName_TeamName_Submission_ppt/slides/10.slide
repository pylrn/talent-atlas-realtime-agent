<Slide style={{
    width: 1280,
    height: 720,
    padding: '0 72px',
    background: '#FFFFFF',
}}>
    <Box style={{ width: '100%', height: 720, flexDirection: 'column' }}>
        <Box style={{
            height: 120,
            paddingTop: 20,
            paddingBottom: 16,
            flexDirection: 'column',
            justifyContent: 'flex-end',
        }}>
            <Box style={{ width: 56, height: 6, background: '#97C459', marginBottom: 14 }} />
            <Text style={{ fontFamily: 'Inter', fontSize: 34, fontWeight: 'bold', color: '#0B1F1A' }}>
                Tools and tech stack
            </Text>
        </Box>

        <Box style={{ height: 540, flexDirection: 'row', gap: 34 }}>
            <Box style={{
                width: 300,
                background: 'linear-gradient(160deg, #04342C 0%, #0F6E56 100%)',
                padding: '28px 24px',
                flexDirection: 'column',
            }}>
                <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 13, color: '#97C459', letterSpacing: 1.6 }}>
                    A DYNAMIC MANIFEST
                </Text>
                <Text style={{ fontFamily: 'Inter', fontSize: 22, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.45, marginTop: 18 }}>
                    Ten tools, each declaring what it is allowed to do
                </Text>
                <Text style={{ fontFamily: 'Inter', fontSize: 16, lineHeight: 1.55, color: 'rgba(225,245,238,0.88)', marginTop: 16 }}>
                    Effect, blocking behaviour, scope and idempotency are declared once and enforced at dispatch. Nine tools can
                    only read. Exactly one can write.
                </Text>
                <Box style={{ marginTop: 'auto', paddingTop: 18 }}>
                    <Box style={{ height: 1, background: 'rgba(225,245,238,0.28)', marginBottom: 14 }} />
                    <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 13, color: '#97C459' }}>
                        DRIFT GUARD
                    </Text>
                    <Text style={{ fontFamily: 'Inter', fontSize: 15, lineHeight: 1.5, color: 'rgba(225,245,238,0.82)', marginTop: 6 }}>
                        A test fails if any declared tool is missing from the system prompt, so the manifest and the instructions
                        cannot drift apart.
                    </Text>
                </Box>
            </Box>

            <Box style={{ width: 802, flexDirection: 'column', gap: 24 }}>
                <Box style={{
                    height: 300,
                    border: '1px solid #E1F5EE',
                    padding: '20px 24px',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 13, color: '#0F6E56', letterSpacing: 1.5 }}>
                        READ-ONLY · 9 TOOLS
                    </Text>
                    <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 10, marginTop: 14 }}>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>search_candidates</Text>
                        </Box>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>inspect_candidate</Text>
                        </Box>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>compare_candidates</Text>
                        </Box>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>list_skills</Text>
                        </Box>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>use_role_image</Text>
                        </Box>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>format_current_answer</Text>
                        </Box>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>interrupt_search</Text>
                        </Box>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>cancel_current_action</Text>
                        </Box>
                        <Box style={{ padding: '7px 14px', background: '#E1F5EE', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#04342C' }}>request_clarification</Text>
                        </Box>
                    </Box>

                    <Box style={{ height: 1, background: '#E1F5EE', marginTop: 'auto', marginBottom: 18 }} />

                    <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 13, color: '#0F6E56', letterSpacing: 1.5 }}>
                        STATE-MODIFYING · 1 TOOL
                    </Text>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginTop: 14 }}>
                        <Box style={{ padding: '9px 16px', background: '#04342C', borderRadius: 4 }}>
                            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 15, color: '#97C459', fontWeight: 'bold' }}>
                                add_to_shortlist
                            </Text>
                        </Box>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15.5, color: '#6B7280', flex: 1 }}>
                            Idempotency key · scope supersession · recorded in the effect log
                        </Text>
                    </Box>
                </Box>

                <Box style={{ height: 216, flexDirection: 'column' }}>
                    <Box style={{ flexDirection: 'row', paddingBottom: 8, borderBottom: '2px solid #04342C' }}>
                        <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 12, color: '#6B7280', letterSpacing: 1.5, width: 150 }}>
                            LAYER
                        </Text>
                        <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 12, color: '#6B7280', letterSpacing: 1.5, flex: 1, paddingLeft: 16 }}>
                            WHAT WE USE
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 38, borderBottom: '1px solid #E1F5EE' }}>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, fontWeight: 600, color: '#0B1F1A', width: 150 }}>Transport</Text>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, color: '#6B7280', flex: 1, paddingLeft: 16 }}>
                            Gemini Live (full duplex) · FastAPI · Uvicorn
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 38, borderBottom: '1px solid #E1F5EE' }}>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, fontWeight: 600, color: '#0B1F1A', width: 150 }}>Data</Text>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, color: '#6B7280', flex: 1, paddingLeft: 16 }}>
                            PostgreSQL 17 + pgvector · PgBouncer · Redis 7
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 38, borderBottom: '1px solid #E1F5EE' }}>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, fontWeight: 600, color: '#0B1F1A', width: 150 }}>Retrieval</Text>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, color: '#6B7280', flex: 1, paddingLeft: 16 }}>
                            vector + BM25 + SQL + skills · RRF fusion · rerank
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 38, borderBottom: '1px solid #E1F5EE' }}>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, fontWeight: 600, color: '#0B1F1A', width: 150 }}>Runtime</Text>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, color: '#6B7280', flex: 1, paddingLeft: 16 }}>
                            Python 3.13 · pydantic v2 · Docker Compose
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 38 }}>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, fontWeight: 600, color: '#0B1F1A', width: 150 }}>Verification</Text>
                        <Text style={{ fontFamily: 'Inter', fontSize: 15, color: '#6B7280', flex: 1, paddingLeft: 16 }}>
                            pytest · pytest-asyncio · ruff · jsdom
                        </Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        <Box style={{
            height: 60,
            paddingBottom: 20,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}>
            <Text style={{ fontFamily: 'Inter', fontSize: 14, color: '#6B7280' }}>
                Talent Atlas · Samsung PRISM Y2026 · Theme 05
            </Text>
            <Text style={{ fontFamily: 'JetBrains Mono', fontSize: 14, color: '#6B7280' }}>
                10 / 12
            </Text>
        </Box>
    </Box>
</Slide>
