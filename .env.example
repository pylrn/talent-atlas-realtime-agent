# ─── Database ─────────────────────────────
POSTGRES_USER=hybrid_user
POSTGRES_PASSWORD=hybrid_pass
POSTGRES_DB=hiring_platform
DATABASE_URL=postgresql://hybrid_user:hybrid_pass@localhost:5432/hiring_platform

# Local runtime directories are exported by scripts/setup_external_runtime.sh.
# The script refuses to run unless this checkout is on /Volumes/MAC.
RUNTIME_ROOT=.runtime

# Use this URL when PgBouncer is running (production)
# DATABASE_URL=postgresql://hybrid_user:hybrid_pass@localhost:6432/hiring_platform

# Optional read/search database. For Supabase + ParadeDB, keep DATABASE_URL on
# Supabase and point SEARCH_DATABASE_URL at the ParadeDB logical replica.
SEARCH_DATABASE_URL=
SEARCH_DB_POOL_MIN=0
SEARCH_DB_POOL_MAX=0

# ─── Cache ────────────────────────────────
# memory keeps a process-local LRU cache. redis adds a shared L2 cache
# across workers/app nodes while preserving the local L1 hot path.
CACHE_BACKEND=memory
REDIS_URL=
CACHE_NAMESPACE=hybrid-search
CACHE_LOCAL_MAXSIZE=2048
CACHE_REDIS_SOCKET_TIMEOUT_SECONDS=0.2
CACHE_REDIS_CONNECT_TIMEOUT_SECONDS=0.2
# Opt-in after staging benchmarks. Caches compact count/dense/BM25/skill rowsets.
SEARCH_USE_RETRIEVAL_CACHE=false

# Read-only DSN for agent ad-hoc SQL tool
AGENT_READONLY_DATABASE_URL=postgresql://agent_ro_user:changeme@localhost:5432/hiring_platform

# ─── Embedding Provider ──────────────────
# Options: openai, gemini, cohere, voyage, jina, local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Pending embedding experiment (requires re-embedding before activation)
PENDING_EMBEDDING_PROVIDER=
PENDING_EMBEDDING_MODEL=
PENDING_EMBEDDING_DIMENSIONS=

# Reranking experiment default
RERANKER_MODEL=local-fast

# ─── API Keys (set whichever provider you use) ──
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
GEMINI_LIVE_MODEL=gemini-3.8-live
# End-of-turn silence before the voice agent responds. Raise for more thinking time.
GEMINI_LIVE_VAD_SILENCE_MS=1200
GEMINI_LIVE_VAD_PREFIX_MS=200
COHERE_API_KEY=...
VOYAGE_API_KEY=pa-...
JINA_API_KEY=jina_...

# ─── Search Tuning ───────────────────────
# ef_search: lower = faster (<100ms), higher = better recall
# 40 is a good default for <100ms latency at scale
HNSW_EF_SEARCH=40

# Keyword backend: fts keeps the current Postgres ts_rank_cd path; paradedb
# uses pg_search BM25 and requires a ParadeDB/self-managed Postgres target.
BM25_BACKEND=fts
BM25_OVERFETCH_FACTOR=4
BM25_OVERFETCH_MIN=60

# ─── API ──────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
