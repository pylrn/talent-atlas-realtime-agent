                         </div>\n                                    </div>\n                                    <div class=\"space-y-1.5\" data-kid=\"133\">\n                                        <div class=\"flex justify-between text-[11px] font-bold text-[#003153]\" data-kid=\"134\">\n                                            <span data-kid=\"135\">Semantic Similarity</span>\n                                            <span class=\"text-[#43B3AE]\" data-kid=\"136\">0.94</span>\n                                        </div>\n                                        <div class=\"h-1.5 w-full bg-[#003153]/5 rounded-full overflow-hidden\" data-kid=\"137\">\n                                            <div class=\"h-full bg-[#43B3AE] rounded-full\" style=\"width: 94%\" data-kid=\"138\"></div>\n                                        </div>\n                                    </div>\n                                    <div class=\"space-y-1.5\" data-kid=\"139\">\n                                        <div class=\"flex justify-between text-[11px] font-bold text-[#003153]\" data-kid=\"140\">\n                                            <span data-kid=\"141\">Feature Boost <span class=\"text-[9px] font-medium text-[#003153]/40 ml-1\" data-kid=\"142\">(Prefs)</span></span>\n                                            <span class=\"text-[#43B3AE]\" data-kid=\"143\">+12%</span>\n                                        </div>\n                                        <div class=\"h-1.5 w-full bg-[#003153]/5 rounded-full overflow-hidden\" data-kid=\"144\">\n                                            <div class=\"h-full bg-[#43B3AE] rounded-full\" style=\"width: 65%\" data-kid=\"145\"></div>\n                                        </div>\n                                    </div>\n                                    <div class=\"space-y-1.5\" data-kid=\"146\">\n                                        <div class=\"flex justify-between text-[11px] font-bold text-[#0031