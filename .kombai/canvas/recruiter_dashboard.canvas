      "html": "<style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        body {\n            background-color: #F8F8FF;\n            color: #003153;\n            font-family: 'DM Sans', sans-serif;\n            letter-spacing: -0.01em;\n            margin: 0;\n        }\n\n        .font-heading {\n            font-family: 'Inter', sans-serif;\n        }\n\n        .glass-panel {\n            background: rgba(255, 255, 255, 0.6);\n            backdrop-filter: blur(40px) saturate(180%);\n            border: 1px solid rgba(255, 255, 255, 0.5);\n            box-shadow: 0 25px 50px -12px rgba(0, 49, 83, 0.08);\n        }\n\n        .shadow-soft {\n            box-shadow: 0 10px 30px -10px rgba(0, 49, 83, 0.05);\n        }\n\n        .no-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n        .no-scrollbar {\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n\n        /* Expandable content animation */\n        details summary::-webkit-details-marker {\n            display: none;\n        }\n        details[open] summary .toggle-icon {\n            transform: rotate(180deg);\n        }\n    </style>\n\n    <div class=\"relative min-h-[1200px] flex flex-col overflow-hidden\" data-kid=\"0\">\n        \n        <div class=\"absolute -top-[10%] -right-[10%] w-[600px] h-[600px] bg-[#43B3AE]/10 blur-[150px] rounded-full -z-10 animate-pulse pointer-events-none\" data-kid=\"1\"></div>\n        <div class=\"absolute top-[30%] -left-[5%] w-[400px] h-[400px] bg-[#003153]/5 blur-[120px] rounded-full -z-10 pointer-events-none\" data-kid=\"2\"></div>\n\n        \n        <nav class=\"relative z-50 bg-white/80 backdrop-blur-md border-b border-[#003153]/5 px-8 py-4 flex items-center justify-between\" data-kid=\"3\">\n            <div